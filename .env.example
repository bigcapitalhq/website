# Canonical production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://bigcapital.app

# Optional search engine verification codes.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional GitHub token for the repository star count in the header. Raises the
# unauthenticated API rate limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=
